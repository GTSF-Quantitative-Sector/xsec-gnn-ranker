{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Read docs/PLAN.md to see current pipeline status before starting work. After each commit, or before ending the session, update docs/PLAN.md to reflect any progress.'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(echo:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(where:*)",
      "Bash(which:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(python --version)",
      "Bash(pyright:*)",
      "Bash(ruff check:*)",
      "Bash(pytest:*)"
    ]
  }
}
